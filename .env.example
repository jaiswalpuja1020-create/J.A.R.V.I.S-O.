# GEMINI_API_KEY: Primary AI API provider (Auto-injected in AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Cloud Run application URL
APP_URL="MY_APP_URL"

# J.A.R.V.I.S.-O Identity & Personality
JARVIS_O_NAME="J.A.R.V.I.S.-O"
JARVIS_O_PERSONALITY="futuristic, professional, helpful, intelligent"
JARVIS_DEFAULT_LANGUAGE="auto"

# Feature Flags
ENABLE_WEB_SEARCH="true"
ENABLE_FILE_SEARCH="true"
ENABLE_CONVERSATION_MEMORY="true"

# AI Provider Configuration
AI_DEFAULT_PROVIDER="gemini"
AI_FALLBACK_ENABLED="true"
AI_MAX_FALLBACK_ATTEMPTS="2"

# Direct Approved AI Model Providers (Server-Side Secrets)
NVIDIA_API_KEY=""
LLM7_API_KEY=""
OPENROUTER_API_KEY=""

# Optional Web Search Provider (e.g., tavily, serpapi, bing)
SEARCH_PROVIDER=""
SEARCH_API_KEY=""

# System & Security Parameters
PORT="3000"
NODE_ENV="development"
ALLOWED_ORIGINS=""
AI_REQUEST_TIMEOUT_MS="30000"
AI_MAX_OUTPUT_TOKENS="2048"
MAX_CONVERSATION_MESSAGES="30"
MAX_UPLOAD_SIZE_MB="10"
SESSION_TTL_MINUTES="60"

